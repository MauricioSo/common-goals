{
    "name": "common-goals/plugin",
    "description": "Create goal-oriented community boards with contributions, responses, and living guides.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=8.1"
    },
    "autoload": {
        "psr-4": {
            "CommonGoals\\": "common-goals/includes/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CommonGoals\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5",
        "brain/monkey": "^2.6",
        "yoast/phpunit-polyfills": "^2.0",
        "phpstan/phpstan": "^1.11",
        "php-stubs/wordpress-stubs": "^7.0",
        "squizlabs/php_codesniffer": "^3.10",
        "infection/infection": "0.29"
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite unit",
        "test:property": "phpunit --testsuite property",
        "test:integration": "@php -d error_reporting=22527 vendor/bin/phpunit --configuration phpunit-integration.xml.dist",
        "stan": "phpstan analyse",
        "sniff": "phpcs --standard=WordPress common-goals/includes common-goals/templates --ignore=tests",
        "lint": "php -l common-goals/common-goals.php && find common-goals/includes -name '*.php' -exec php -l {} \\;",
        "mutation": "infection --threads=4 --show-mutations --ignore-msi-with-no-mutations"
    },
    "config": {
        "allow-plugins": true
    }
}
